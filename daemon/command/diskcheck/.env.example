# Copy this file to .env in the same folder, then edit for your system.
# .env is gitignored — your real mount paths never get committed.
#
# MOUNTS: One mount per line in format "path:threshold:label"
#   path      — directory to check (reports the filesystem it's on)
#   threshold — 0-100, alert fires at/above this percentage
#   label     — display name in Telegram message
#
# Add or remove lines as needed for your system.

MOUNTS="
/:80:Root
/home:80:Home
/mnt/data1:85:Storage
/mnt/backup:90:Backup
"

# Shown in message header (e.g. "⚠️ nas — disk space")
HOSTNAME_LABEL="nas"
