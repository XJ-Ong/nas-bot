# Copy to ~/.config/nas-bot/secrets (install.sh does this for you), then:
#   chmod 600 ~/.config/nas-bot/secrets
#
# This file is read by lib.py using python-dotenv, so use KEY="value" format.

BOT_TOKEN="123456789:AAExampleTokenFromBotFather"
CHAT_ID="-987654321"

# Comma-separated Telegram user IDs allowed to run commands, even within
# a shared/family group chat. Leave empty to allow anyone in the chat.
ALLOWED_USER_IDS="111111111,222222222"
